# Copier ce fichier en .env et remplacer les valeurs.
# .env ne doit JAMAIS être commité (voir .gitignore).

# --- Postgres ---------------------------------------------------------
POSTGRES_USER=carbonghost
POSTGRES_PASSWORD=changeme

# --- Auth / JWT (service-user) ----------------------------------------
JWT_SECRET=changeme-en-production
JWT_EXPIRATION_MINUTES=60

# --- LLM (service-assistant) -------------------------------------------
# Clé gratuite sur https://console.groq.com/keys
# Sans clé, l'assistant répond quand même, à partir des données, sans IA.
GROQ_API_KEY=

# --- Calcul carbone (service-carbone) ----------------------------------
CARBON_FACTOR_KG_PER_KWH=0.5
EXPECTED_KWH_PER_UNIT=0.1
